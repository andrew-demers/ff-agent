# ESPN private-league session cookies (see README for how to grab these from your browser)
ESPN_S2=
SWID=

# Which LLM backend to use for the recommendation step: "anthropic" or "ollama"
LLM_PROVIDER=anthropic

# Anthropic API key (required if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# Ollama settings (used if LLM_PROVIDER=ollama; requires a running local Ollama server)
OLLAMA_MODEL=llama3.1
OLLAMA_HOST=http://localhost:11434
